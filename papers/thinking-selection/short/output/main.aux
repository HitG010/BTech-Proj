\newlabel{tab:main}{{1}{3}{Main panel, Qwen3-1.7B, $\lam =0.05$, averaged over both draw directions (400 states). Tokens include the paid draft. Differences are against confidence, with 90\% whole-question intervals holding fitted actions fixed. Lift is accuracy minus random escalation at the same token cost, in percentage points. $^\dagger $Derived from the reported accuracy and tokens. Rows without an interval were not bootstrapped against confidence}{table.caption.5}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Results}{3}{section.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}No tested rule beats confidence}{3}{subsection.3.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}The result holds across costs}{3}{subsection.3.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Accuracy and output cost of the tested deferral rules. In each panel, the dashed line is random escalation at equal cost between always accepting the draft and always thinking, and the square is the hindsight oracle. Lines trace rules refitted at ten cost preferences from $\lambda =0$ to $0.3$; large dots mark $\lambda =0.05$. The combined learner is the predeclared learner. Panels use different axes. Values are post-hoc, on reused development panels, and carry no intervals.}}{4}{figure.caption.6}\protected@file@percent }
\newlabel{fig:curves}{{1}{4}{Accuracy and output cost of the tested deferral rules. In each panel, the dashed line is random escalation at equal cost between always accepting the draft and always thinking, and the square is the hindsight oracle. Lines trace rules refitted at ten cost preferences from $\lam =0$ to $0.3$; large dots mark $\lam =0.05$. The combined learner is the predeclared learner. Panels use different axes. Values are post-hoc, on reused development panels, and carry no intervals}{figure.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces 90\% intervals with fitted actions held fixed and with refitting included, for utility contrasts at $\lambda =0.05$. Copied questions in the refit bootstrap reduce the number of distinct training questions, so those intervals are approximate. The last column gives the 5th--95th percentiles over 200 fold repartitions.}}{4}{table.caption.7}\protected@file@percent }
\newlabel{tab:refit}{{2}{4}{90\% intervals with fitted actions held fixed and with refitting included, for utility contrasts at $\lam =0.05$. Copied questions in the refit bootstrap reduce the number of distinct training questions, so those intervals are approximate. The last column gives the 5th--95th percentiles over 200 fold repartitions}{table.caption.7}{}}
